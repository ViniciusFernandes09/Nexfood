# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# dados do SEU projeto Supabase (Settings > API no painel do Supabase).
#
# Se você deixar este arquivo em branco / não criar o .env, o app continua
# funcionando normalmente, só que 100% local (sem login, sem sincronização
# entre dispositivos) — exatamente como antes.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui
